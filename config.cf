server{
	server_name 	 	nom;
	listen 				8080;
	root ./root/server1;
	default	index.html;
	protocol	GET POST;
	host	0.0.0.0;
	{
		location /;
		methods GET POST;
		root ./root/server1;
		autoindex on;
		upload_path  ./root/server1/upload;
		redirection https://www.youtube.com/watch?v=dQw4w9WgXcQ;
	}
	{
		location /cgi/;
		methods GET POST;
		root ./root/server1;
		autoindex on;
		cgi on;
	}
}